DATABASE_URL=postgresql+asyncpg://pme:password@localhost:5432/pme
REDIS_URL=redis://localhost:6379/0

# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
# KEY_PEPPER: changing it invalidates every existing API key. Keep it out of the database and git.
KEY_PEPPER=
SESSION_SECRET=

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# ---- ERP export (read-only, stateless). Leave ERP_BASE_URL empty to disable: /v1/erp/* returns 503.
ERP_BASE_URL=
ERP_AUTH_MODE=bearer              # bearer | basic | header | none
ERP_API_TOKEN=                    # bearer token, or the key value when ERP_AUTH_MODE=header
ERP_AUTH_HEADER=X-API-Key         # only for ERP_AUTH_MODE=header
ERP_USERNAME=                     # only for ERP_AUTH_MODE=basic
ERP_PASSWORD=
ERP_VERIFY_TLS=true
ERP_CONNECT_TIMEOUT=5
ERP_READ_TIMEOUT=30
ERP_MAX_CONNECTIONS=8
ERP_MAX_RETRIES=4
ERP_BACKOFF_BASE=0.5
ERP_BACKOFF_MAX=20
ERP_RETRY_BUDGET=60
ERP_PAGE_SIZE=500
ERP_LIMIT_PARAM=limit
ERP_OFFSET_PARAM=offset
ERP_RESULTS_KEY=data              # dotted path to the record list; empty if the response IS the list
ERP_TOTAL_KEY=                    # dotted path to the total count, e.g. meta.total (optional)
ERP_TRUST_SHORT_PAGES=false
ERP_MAX_EXPORT_ROWS=500000
ERP_EXPORT_PER_MINUTE=5

# Tests only (database name MUST end in _test):
TEST_DATABASE_URL=postgresql+asyncpg://pme:password@localhost:5432/pme_test
TEST_REDIS_URL=redis://localhost:6379/15

# ---- File import (mode B)
INGEST_MAX_MB=25
INGEST_PER_MINUTE=10
